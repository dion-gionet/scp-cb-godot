# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Test output and local run files
tests/shots/
tests/reports/
tests/bot_report.txt
tests/hunt/
tests/parity.json
tests/dev_server.pid
override.cfg

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Game files from tools/fetch_assets.py
assets/*
!assets/.gdignore

# Local export folder
build/*
!build/.gdignore

# Python caches
__pycache__/

# Scratch screenshots and logs from hunts
/after*.png
/after*.png.import
/r2.txt
tests/*.png
tests/*.png.import
